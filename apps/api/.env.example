# --- runtime
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug
# Comma-separated origins allowed by CORS (mobile apps don't need this; the admin web app does)
CORS_ORIGINS=http://localhost:5173

# --- database (Fly Postgres with PostGIS). Pooled URL for the app, direct URL for migrations.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/chicago
DATABASE_URL_DIRECT=postgres://postgres:postgres@localhost:5432/chicago

# --- auth (we issue our own JWTs; generate with: openssl rand -base64 48)
JWT_SECRET=change-me-to-48-random-bytes
JWT_ISSUER=wm-chicago-maps
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=90
# Native Sign in with Apple / Google — the bundle id / client ids the identity tokens are issued for
APPLE_BUNDLE_ID=com.wmchicagomaps
GOOGLE_CLIENT_IDS=your-ios-client-id.apps.googleusercontent.com

# --- self-hosted geo services (Flycast addresses in production)
# Self-hosted Photon (docker compose --profile geo, after the data build in infra/fly/build-data.md).
# Without that, PHOTON_URL=https://photon.komoot.io works for local dev only — it is a fair-use public
# instance, not for production traffic. Production uses the Flycast address (see fly.toml).
PHOTON_URL=http://localhost:2322
VALHALLA_URL=http://localhost:8002

# --- upstream data (see .claude/commands/add-chicago-apis.md for where each key comes from)
SOCRATA_APP_TOKEN=            # data.cityofchicago.org → Developer Settings (optional; raises rate limits)
CTA_TRAIN_KEY=                # transitchicago.com/developers/traintracker
CTA_BUS_KEY=                  # transitchicago.com/developers/bustracker
METRA_API_KEY=                # metra.com/developers
TICKETMASTER_KEY=             # developer.ticketmaster.com
BANDSINTOWN_APP_ID=           # artists.bandsintown.com/support/api-installation
OVERPASS_URL=https://overpass-api.de/api/interpreter

# --- observability
SENTRY_DSN=
