{
  "name": "wm-chicago-maps-backend",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.11"
  },
  "scripts": {
    "dev": "pnpm --filter @wm/api dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @wm/db generate",
    "db:migrate": "pnpm --filter @wm/db migrate",
    "fly:deploy": "flyctl deploy --remote-only",
    "fly:logs": "flyctl logs --app chicago-api",
    "fly:ssh": "flyctl ssh console --app chicago-api"
  },
  "devDependencies": {
    "turbo": "^2.5.0",
    "typescript": "^5.8.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
